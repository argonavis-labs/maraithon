<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      App Sandbox is OFF.

      The companion reads ~/Library/Messages/chat.db which requires Full
      Disk Access. Full Disk Access is incompatible with the App Sandbox;
      the user grants it manually in System Settings → Privacy & Security
      → Full Disk Access. We still ship under Hardened Runtime + Developer
      ID notarization so this remains a trustworthy install.
    -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Outbound network for /api/v1/companion/messages, whoami, etc. -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Contacts.framework read access for CRM identity merging. -->
    <key>com.apple.security.personal-information.addressbook</key>
    <true/>

    <!--
      EventKit access. Without these, requestFullAccessToEvents /
      requestFullAccessToReminders auto-deny without ever presenting
      the permission prompt (observed on macOS 26: instant
      granted=false with no TCC row and a valid usage-description
      string). The existing Reminders grant predates the check; any
      fresh prompt needs the entitlement.
    -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <key>com.apple.security.personal-information.reminders</key>
    <true/>
</dict>
</plist>
