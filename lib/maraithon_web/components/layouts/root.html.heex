<!DOCTYPE html>
<html lang="en" class="h-full bg-zinc-50">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#18181b" />
    <meta name="color-scheme" content="light" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Maraithon" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="format-detection" content="telephone=no" />
    <title>Maraithon — Todos</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/images/app-icon.svg" />
    <link rel="apple-touch-icon" href="/images/app-icon-192.png" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"
    />
    <style>
      #todo-loading-shell {
        position: fixed;
        inset: 0;
        z-index: 2147483647;
        min-height: 100vh;
        min-height: 100svh;
        overflow: hidden;
        background: #fafafa;
        color: #18181b;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      #todo-loading-shell[hidden] { display: none !important; }
      #todo-loading-shell *, #todo-loading-shell *::before, #todo-loading-shell *::after { box-sizing: border-box; }
      #todo-loading-shell .todo-boot-sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .todo-boot-pulse { animation: todo-boot-pulse 1.6s ease-in-out infinite; }
      .todo-boot-nav { height: 3.5rem; border-bottom: 1px solid rgba(24, 24, 27, 0.1); background: #fff; }
      .todo-boot-nav-inner, .todo-boot-main { width: 100%; max-width: 72rem; margin: 0 auto; }
      .todo-boot-nav-inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0 2rem; }
      .todo-boot-nav-left, .todo-boot-nav-links, .todo-boot-header, .todo-boot-toolbar, .todo-boot-controls, .todo-boot-stack { display: flex; align-items: center; }
      .todo-boot-nav-left { gap: 1.5rem; }
      .todo-boot-nav-links, .todo-boot-controls { gap: 0.5rem; }
      .todo-boot-main { padding: 2rem; }
      .todo-boot-stack { flex-direction: column; align-items: stretch; gap: 1rem; }
      .todo-boot-header, .todo-boot-toolbar { justify-content: space-between; gap: 1rem; }
      .todo-boot-panel { overflow: hidden; border: 1px solid rgba(24, 24, 27, 0.1); border-radius: 0.5rem; background: #fff; box-shadow: 0 1px 2px rgba(24, 24, 27, 0.05); }
      .todo-boot-toolbar { min-height: 4.5rem; padding: 1rem 1.25rem; border-bottom: 1px solid rgba(24, 24, 27, 0.1); }
      .todo-boot-table { min-width: 56rem; }
      .todo-boot-grid { display: grid; grid-template-columns: 2.5rem minmax(20rem, 1.6fr) minmax(10rem, 0.7fr) 9rem 5rem; align-items: start; gap: 1rem; padding: 1rem 1.25rem; border-bottom: 1px solid rgba(24, 24, 27, 0.06); }
      .todo-boot-grid:last-child { border-bottom: 0; }
      .todo-boot-grid-head { min-height: 2.75rem; align-items: center; padding-top: 0.75rem; padding-bottom: 0.75rem; background: rgba(250, 250, 250, 0.75); border-bottom-color: rgba(24, 24, 27, 0.1); }
      .todo-boot-row { min-height: 6rem; }
      .todo-boot-cell { display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem; }
      .todo-boot-line { display: block; height: 0.75rem; border-radius: 0.25rem; background: #e4e4e7; }
      .todo-boot-line-light { background: #f4f4f5; }
      .todo-boot-box { display: block; height: 2.25rem; border-radius: 0.375rem; background: #f4f4f5; }
      .todo-boot-check { width: 1rem; height: 1rem; border-radius: 0.25rem; background: #e4e4e7; }

      @keyframes todo-boot-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.58; }
      }

      @media (max-width: 640px) {
        .todo-boot-nav-inner { padding: 0 1rem; }
        .todo-boot-nav-links { display: none; }
        .todo-boot-main { padding: 1.5rem 1rem; }
        .todo-boot-toolbar { align-items: flex-start; flex-direction: column; }
      }

      @media (prefers-reduced-motion: reduce) {
        .todo-boot-pulse { animation: none; }
      }
    </style>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="h-full bg-zinc-50 font-sans text-zinc-950 antialiased">
    <%= @inner_content %>
  </body>
</html>
