#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  delegation-eval-start) task=delegation_eval_start ;;
  delegation-eval-status) task=delegation_eval_status ;;
  *) echo "Expected delegation-eval-start or delegation-eval-status" >&2; exit 1 ;;
esac

source "$(dirname "$0")/delegation-eval-config"
scenario="${DELEGATION_EVAL_SCENARIO:-information_reply}"
case "${scenario}" in
  information_reply|schedule_and_book|accepted_slot_becomes_busy) ;;
  *) echo "Unknown controlled eval scenario" >&2; exit 1 ;;
esac
eval_env+="|DELEGATION_EVAL_SCENARIO=${scenario}"

started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
gcloud run jobs execute maraithon-todo-validation --project maraithon --region us-central1 \
  --args="^@^eval@Maraithon.Release.${task}" --update-env-vars "${eval_env}" --wait --quiet

for attempt in $(seq 1 20); do
  report="$(gcloud logging read \
    "resource.type=cloud_run_job AND resource.labels.job_name=maraithon-todo-validation AND timestamp>=\"${started_at}\" AND textPayload:\"DELEGATION_EVAL=\"" \
    --project maraithon --limit 1 --order=desc --format='value(textPayload)')"
  if [[ "${report}" == DELEGATION_EVAL=* ]]; then
    echo "${report}"
    exit 0
  fi
  sleep 3
done
echo "Eval operation finished without a report" >&2
exit 1
