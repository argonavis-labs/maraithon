#!/usr/bin/env bash

set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

project="${MARAITHON_GCP_PROJECT:-maraithon}"
region="${MARAITHON_GCP_REGION:-us-central1}"
service="${MARAITHON_GCP_SERVICE:-maraithon}"
runtime_service_account="${MARAITHON_GCP_RUNTIME_SERVICE_ACCOUNT:-maraithon-runtime@${project}.iam.gserviceaccount.com}"
repository="${MARAITHON_GCP_ARTIFACT_REPOSITORY:-maraithon}"
database_instance="${MARAITHON_GCP_DATABASE_INSTANCE:-maraithon-db}"
exact_runtime_enabled="${MARAITHON_EXACT_RUNTIME_ENABLED:-true}"
coordination_enabled="${MARAITHON_MULTINODE_COORDINATION_ENABLED:-true}"
protocol_revision="${MARAITHON_RUNTIME_PROTOCOL_REVISION:-5e0aa5a19e968f7bf026a926f77550707d59d41a}"

require_command gcloud
require_command git
require_command curl

if [[ "${project}" != "maraithon" ]]; then
  echo "Refusing to deploy an unpinned GCP project: ${project}" >&2
  exit 64
fi

revision="$(git -C "${ROOT_DIR}" rev-parse HEAD)"
project_number="$(gcloud projects describe "${project}" --format='value(projectNumber)')"
connection="${project}:${region}:${database_instance}"
socket_dir="/cloudsql/${connection}"
image="${region}-docker.pkg.dev/${project}/${repository}/${service}:${revision}"
host="${service}-${project_number}.${region}.run.app"

# Cloud Build keeps Docker tooling and registry credentials out of the deployer.
run_in "${ROOT_DIR}" gcloud builds submit   --project "${project}"   --region "${region}"   --tag "${image}"   --timeout 1800s   --quiet .

common_env="CLOUD_SQL_SOCKET_DIR=${socket_dir},DATABASE_TLS_MODE=private_network_override,DATABASE_TLS_INSECURE_CONFIRMATION=I_ACKNOWLEDGE_DATABASE_TLS_IS_NOT_VERIFIED,DATABASE_TLS_INSECURE_REASON=gcp_cloud_sql_unix_socket,PHX_HOST=${host},PRIMARY_ADMIN_EMAIL=kent@voteagora.com,LLM_PROVIDER=openrouter,LLM_MODEL=qwen/qwen3.7-max,OPENROUTER_CHAT_MODEL=qwen/qwen3.7-plus,OPENROUTER_FAST_MODEL=qwen/qwen3.6-flash,OPENROUTER_REASONING_EFFORT=medium,EXACT_AGENT_RUNTIME_ENABLED=${exact_runtime_enabled},MULTINODE_COORDINATION_ENABLED=${coordination_enabled},GIT_SHA=${protocol_revision},POOL_SIZE=8,DATABASE_POOL_MODE=session"

migration_secrets="DATABASE_URL=maraithon-migrator-db-url:latest,DIRECT_DATABASE_URL=maraithon-migrator-db-url:latest,SECRET_KEY_BASE=maraithon-secret-key-base:latest,API_BEARER_TOKEN=maraithon-api-bearer-token:latest,ADMIN_PASSWORD=maraithon-admin-password:latest,OPENROUTER_API_KEY=maraithon-openrouter-api-key:latest,CLOAK_KEY=maraithon-cloak-key:latest,DURABLE_PAYLOAD_BINDING_CURRENT_KEY=maraithon-payload-binding-key:latest,RELEASE_COOKIE=maraithon-release-cookie:latest"

gcloud run jobs deploy "${service}-migrate"   --project "${project}"   --region "${region}"   --image "${image}"   --service-account "${runtime_service_account}"   --set-cloudsql-instances "${connection}"   --set-env-vars "${common_env}"   --set-secrets "${migration_secrets}"   --command /app/bin/maraithon   --args eval,Maraithon.Release.migrate   --cpu 1   --memory 2Gi   --task-timeout 30m   --max-retries 0   --quiet

gcloud run jobs execute "${service}-migrate"   --project "${project}"   --region "${region}"   --wait   --quiet

runtime_secrets="DATABASE_URL=maraithon-runtime-db-url:latest,SECRET_KEY_BASE=maraithon-secret-key-base:latest,API_BEARER_TOKEN=maraithon-api-bearer-token:latest,ADMIN_PASSWORD=maraithon-admin-password:latest,OPENROUTER_API_KEY=maraithon-openrouter-api-key:latest,CLOAK_KEY=maraithon-cloak-key:latest,DURABLE_PAYLOAD_BINDING_CURRENT_KEY=maraithon-payload-binding-key:latest,RELEASE_COOKIE=maraithon-release-cookie:latest"

gcloud run deploy "${service}"   --project "${project}"   --region "${region}"   --image "${image}"   --service-account "${runtime_service_account}"   --set-cloudsql-instances "${connection}"   --set-env-vars "${common_env},PHX_SERVER=true,DURABLE_PAYLOAD_BINDING_CURRENT_TAG=HMAC.SHA256.V1,OPENROUTER_HTTP_REFERER=https://maraithon.com,OPENROUTER_APP_TITLE=Maraithon"   --set-secrets "${runtime_secrets}"   --allow-unauthenticated   --port 8080   --cpu 1   --memory 2Gi   --min 1   --max 1   --concurrency 80   --timeout 300   --no-cpu-throttling   --startup-probe 'httpGet.path=/health,initialDelaySeconds=5,timeoutSeconds=5,periodSeconds=5,failureThreshold=24'   --quiet

health_url="https://${host}/health"
curl --fail --silent --show-error "${health_url}" >/dev/null
echo "Deploy health check passed: ${health_url}"
echo "Deployed image revision: ${revision}"
echo "Runtime protocol revision: ${protocol_revision}"
