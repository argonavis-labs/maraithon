#!/usr/bin/env bash

set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

project="${MARAITHON_GCP_PROJECT:-maraithon}"
region="${MARAITHON_GCP_REGION:-us-central1}"
service="${MARAITHON_GCP_SERVICE:-maraithon}"
runtime_service_account="${MARAITHON_GCP_RUNTIME_SERVICE_ACCOUNT:-maraithon-runtime@${project}.iam.gserviceaccount.com}"
repository="${MARAITHON_GCP_ARTIFACT_REPOSITORY:-maraithon}"
database_instance="${MARAITHON_GCP_DATABASE_INSTANCE:-maraithon-db}"
exact_runtime_enabled="${MARAITHON_EXACT_RUNTIME_ENABLED:-true}"
coordination_enabled="${MARAITHON_MULTINODE_COORDINATION_ENABLED:-true}"
protocol_revision="${MARAITHON_RUNTIME_PROTOCOL_REVISION:-5e0aa5a19e968f7bf026a926f77550707d59d41a}"
todo_validation_user="${MARAITHON_VALIDATE_TODO_LAUNCH_USER:-}"

require_command gcloud
require_command git
require_command curl

if [[ "${project}" != "maraithon" ]]; then
  echo "Refusing to deploy an unpinned GCP project: ${project}" >&2
  exit 64
fi

if [[ "${exact_runtime_enabled}" == "true" && "${coordination_enabled}" != "true" ]]; then
  echo "Refusing exact runtime without coordination; durable workers would remain fenced" >&2
  exit 64
fi

revision="$(git -C "${ROOT_DIR}" rev-parse HEAD)"
project_number="$(gcloud projects describe "${project}" --format='value(projectNumber)')"
connection="${project}:${region}:${database_instance}"
socket_dir="/cloudsql/${connection}"
image="${region}-docker.pkg.dev/${project}/${repository}/${service}:${revision}"
host="${service}-${project_number}.${region}.run.app"
gmail_topic_id="${MARAITHON_GMAIL_PUBSUB_TOPIC_ID:-maraithon-gmail-push}"
gmail_subscription_id="${MARAITHON_GMAIL_PUBSUB_SUBSCRIPTION_ID:-maraithon-gmail-push-webhook}"
gmail_topic="projects/${project}/topics/${gmail_topic_id}"
gmail_push_endpoint="https://maraithon.com/webhooks/google/gmail"

# Gmail push requires a topic in the OAuth application's GCP project and the
# Gmail system publisher identity. The deployer can submit builds but is kept
# intentionally unable to mutate Pub/Sub directly, so the existing Cloud Build
# infrastructure authority performs this narrow idempotent provisioning step.
run_in "${ROOT_DIR}" gcloud builds submit   --project "${project}"   --region "${region}"   --no-source   --config "scripts/monorepo/cloudbuild-provision-gmail.yaml"   --substitutions "_TOPIC_ID=${gmail_topic_id},_SUBSCRIPTION_ID=${gmail_subscription_id},_PUSH_ENDPOINT=${gmail_push_endpoint}"   --timeout 300s   --quiet

# Cloud Build keeps Docker tooling and registry credentials out of the deployer.
run_in "${ROOT_DIR}" gcloud builds submit   --project "${project}"   --region "${region}"   --tag "${image}"   --timeout 1800s   --quiet .

common_env="CLOUD_SQL_SOCKET_DIR=${socket_dir},DATABASE_TLS_MODE=private_network_override,DATABASE_TLS_INSECURE_CONFIRMATION=I_ACKNOWLEDGE_DATABASE_TLS_IS_NOT_VERIFIED,DATABASE_TLS_INSECURE_REASON=gcp_cloud_sql_unix_socket,PHX_HOST=maraithon.com,PRIMARY_ADMIN_EMAIL=kent@voteagora.com,LLM_PROVIDER=openrouter,LLM_MODEL=qwen/qwen3.7-max,OPENROUTER_CHAT_MODEL=qwen/qwen3.7-plus,OPENROUTER_FAST_MODEL=qwen/qwen3.6-flash,OPENROUTER_REASONING_EFFORT=medium,GOOGLE_REDIRECT_URI=https://maraithon.com/auth/google/callback,GOOGLE_CALENDAR_WEBHOOK_URL=https://maraithon.com/webhooks/google/calendar,GOOGLE_PUBSUB_TOPIC=${gmail_topic},GITHUB_REDIRECT_URI=https://maraithon.com/auth/github/callback,SLACK_REDIRECT_URI=https://maraithon.com/auth/slack/callback,NOTAUI_REDIRECT_URI=https://maraithon.com/auth/notaui/callback,EXACT_AGENT_RUNTIME_ENABLED=${exact_runtime_enabled},MULTINODE_COORDINATION_ENABLED=${coordination_enabled},GIT_SHA=${protocol_revision},POOL_SIZE=16,DB_QUERY_TIMEOUT_MS=30000,DATABASE_POOL_MODE=session"

migration_secrets="DATABASE_URL=maraithon-migrator-db-url:latest,DIRECT_DATABASE_URL=maraithon-migrator-db-url:latest,SECRET_KEY_BASE=maraithon-secret-key-base:latest,API_BEARER_TOKEN=maraithon-api-bearer-token:latest,ADMIN_PASSWORD=maraithon-admin-password:latest,OPENROUTER_API_KEY=maraithon-openrouter-api-key:latest,CLOAK_KEY=maraithon-cloak-key:latest,DURABLE_PAYLOAD_BINDING_CURRENT_KEY=maraithon-payload-binding-key:latest,RELEASE_COOKIE=maraithon-release-cookie:latest"

gcloud run jobs deploy "${service}-migrate"   --project "${project}"   --region "${region}"   --image "${image}"   --service-account "${runtime_service_account}"   --set-cloudsql-instances "${connection}"   --set-env-vars "${common_env}"   --set-secrets "${migration_secrets}"   --command /app/bin/maraithon   --args eval,Maraithon.Release.migrate   --cpu 1   --memory 2Gi   --task-timeout 30m   --max-retries 0   --quiet

gcloud run jobs execute "${service}-migrate"   --project "${project}"   --region "${region}"   --wait   --quiet

runtime_secrets="DATABASE_URL=maraithon-runtime-db-url:latest,SECRET_KEY_BASE=maraithon-secret-key-base:latest,API_BEARER_TOKEN=maraithon-api-bearer-token:latest,ADMIN_PASSWORD=maraithon-admin-password:latest,OPENROUTER_API_KEY=maraithon-openrouter-api-key:latest,CLOAK_KEY=maraithon-cloak-key:latest,DURABLE_PAYLOAD_BINDING_CURRENT_KEY=maraithon-payload-binding-key:latest,RELEASE_COOKIE=maraithon-release-cookie:latest,POSTMARK_SERVER_TOKEN=maraithon-postmark-server-token:latest,AUTH_EMAIL_FROM=maraithon-auth-email-from:latest,GOOGLE_CLIENT_ID=maraithon-google-client-id:latest,GOOGLE_CLIENT_SECRET=maraithon-google-client-secret:latest,GITHUB_CLIENT_ID=maraithon-github-client-id:latest,GITHUB_CLIENT_SECRET=maraithon-github-client-secret:latest,GITHUB_WEBHOOK_SECRET=maraithon-github-webhook-secret:latest,SLACK_CLIENT_ID=maraithon-slack-client-id:latest,SLACK_CLIENT_SECRET=maraithon-slack-client-secret:latest,SLACK_SIGNING_SECRET=maraithon-slack-signing-secret:latest,NOTAUI_CLIENT_ID=maraithon-notaui-client-id:latest,NOTAUI_CLIENT_SECRET=maraithon-notaui-client-secret:latest"

if ! gcloud run deploy "${service}"   --project "${project}"   --region "${region}"   --image "${image}"   --service-account "${runtime_service_account}"   --set-cloudsql-instances "${connection}"   --set-env-vars "${common_env},PHX_SERVER=true,DURABLE_PAYLOAD_BINDING_CURRENT_TAG=HMAC.SHA256.V1,OPENROUTER_HTTP_REFERER=https://maraithon.com,OPENROUTER_APP_TITLE=Maraithon"   --set-secrets "${runtime_secrets}"   --allow-unauthenticated   --port 8080   --cpu 1   --memory 2Gi   --min 1   --max 1   --concurrency 80   --timeout 300   --no-cpu-throttling   --startup-probe 'httpGet.path=/health,initialDelaySeconds=5,timeoutSeconds=5,periodSeconds=5,failureThreshold=24'   --quiet; then
  failed_revision="$(gcloud run revisions list     --project "${project}"     --region "${region}"     --service "${service}"     --sort-by='~metadata.creationTimestamp'     --limit=1     --format='value(metadata.name)' 2>/dev/null || true)"

  if [[ -n "${failed_revision}" ]]; then
    echo "Cloud Run revision startup diagnostics: ${failed_revision}" >&2
    gcloud run revisions describe "${failed_revision}"       --project "${project}"       --region "${region}"       --format='yaml(status.conditions,status.logUrl)' >&2 || true
    gcloud logging read       "resource.type=cloud_run_revision AND resource.labels.service_name=${service} AND resource.labels.revision_name=${failed_revision}"       --project "${project}"       --freshness=30m       --limit=100       --order=asc       --format='value(timestamp,severity,textPayload,jsonPayload.message)' >&2 || true
  fi

  exit 1
fi

health_url="https://${host}/health"
curl --fail --silent --show-error "${health_url}" >/dev/null
echo "Deploy health check passed: ${health_url}"

if [[ -n "${todo_validation_user}" ]]; then
  if [[ "${todo_validation_user}" != "kent@runner.now" ]]; then
    echo "Refusing Todo validation for an unauthorized account" >&2
    exit 64
  fi

  gcloud run jobs deploy "${service}-todo-validation"     --project "${project}"     --region "${region}"     --image "${image}"     --service-account "${runtime_service_account}"     --set-cloudsql-instances "${connection}"     --set-env-vars "${common_env},DURABLE_PAYLOAD_BINDING_CURRENT_TAG=HMAC.SHA256.V1,TODO_VALIDATION_USER=${todo_validation_user}"     --set-secrets "${runtime_secrets}"     --command /app/bin/maraithon     --args eval,Maraithon.Release.validate_authorized_todo_launch     --cpu 1     --memory 2Gi     --task-timeout 15m     --max-retries 0     --quiet

  validation_started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  if ! gcloud run jobs execute "${service}-todo-validation"     --project "${project}"     --region "${region}"     --wait     --quiet; then
    validation_error=""

    for _attempt in $(seq 1 20); do
      validation_error="$(gcloud logging read       "resource.type=cloud_run_job AND resource.labels.job_name=${service}-todo-validation AND timestamp>=\"${validation_started_at}\" AND textPayload:\"TODO_OUTCOME_VALIDATION_ERROR=\""       --project "${project}"       --limit 1       --order=desc       --format 'value(textPayload)' 2>/dev/null || true)"

      if [[ "${validation_error}" == TODO_OUTCOME_VALIDATION_ERROR=* ]]; then
        break
      fi

      sleep 3
    done

    if [[ "${validation_error}" == TODO_OUTCOME_VALIDATION_ERROR=* ]]; then
      echo "${validation_error}" >&2
    else
      echo "Todo validation failed before an aggregate-only error report was available" >&2
    fi

    exit 1
  fi

  validation_report=""
  for _attempt in $(seq 1 20); do
    validation_report="$(gcloud logging read       "resource.type=cloud_run_job AND resource.labels.job_name=${service}-todo-validation AND timestamp>=\"${validation_started_at}\" AND textPayload:\"TODO_LAUNCH_VALIDATION=\""       --project "${project}"       --limit 1       --order=desc       --format 'value(textPayload)' 2>/dev/null || true)"

    if [[ "${validation_report}" == TODO_LAUNCH_VALIDATION=* ]]; then
      break
    fi

    sleep 3
  done

  if [[ "${validation_report}" != TODO_LAUNCH_VALIDATION=* ]]; then
    echo "Todo validation completed but its aggregate-only report was not available" >&2
    exit 1
  fi

  echo "${validation_report}"
fi

echo "Deployed image revision: ${revision}"
echo "Runtime protocol revision: ${protocol_revision}"
