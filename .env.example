# Local development only. Copy to .env, then load it in your shell:
#   set -a; source .env; set +a
# Mix does not load .env automatically. Never use these credentials in production.

PGHOST=127.0.0.1
PGPORT=55432
PGUSER=maraithon_runtime
PGPASSWORD=maraithon-local-only
PGDATABASE=maraithon_dev
PORT=4000
PRIMARY_ADMIN_EMAIL=developer@example.com

# Optional: configure one model provider to enable AI features.
# Keep keys empty until you want to make billable provider calls.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# LLM_MODEL=

# Optional: register your own Google OAuth application for connected accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Optional: email delivery. Local sign-in is described in README.md.
POSTMARK_SERVER_TOKEN=
AUTH_EMAIL_FROM=
# Production cost warnings use PRIMARY_ADMIN_EMAIL unless overridden here.
# LLM_COST_ALERT_EMAIL=operator@example.com

# Outbound delegation and the development spending override stay off.
DELEGATIONS_ENABLED=false
DELEGATION_GMAIL_SENDS_ENABLED=false
DELEGATION_SLACK_SENDS_ENABLED=false
LLM_DEVELOPMENT_SPENDING=false
