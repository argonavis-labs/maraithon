#!/bin/sh

# Every release command on a Fly Machine must derive the same long node name.
# Keeping this in env.sh (rather than the entrypoint) also configures `rpc`.
if [ -n "${FLY_APP_NAME:-}" ] && \
   [ -n "${FLY_MACHINE_ID:-}" ] && \
   [ -n "${FLY_PRIVATE_IP:-}" ]; then
  export RELEASE_DISTRIBUTION="name"
  export RELEASE_NODE="${FLY_APP_NAME}@${FLY_PRIVATE_IP}"
  export ERL_AFLAGS="${ERL_AFLAGS:-} -proto_dist inet6_tcp"
fi
